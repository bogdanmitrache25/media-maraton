# ============================================================
#  Copia este archivo a `.env.local` y rellena los valores.
#  `.env.local` está en .gitignore: NUNCA se sube al repositorio.
# ============================================================

# --- Supabase (público: se expone al navegador, es seguro) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...tu_anon_key

# --- Supabase (SECRETO: solo servidor, NUNCA en el cliente) ---
# Necesaria para el correo diario: el cron no tiene sesión y debe leer los
# perfiles de todos los atletas saltando RLS. Nunca llega al navegador.
# Dashboard → Project Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (correo diario) ---
# https://resend.com/api-keys
# RESEND_API_KEY=re_...
# Remitente. Sin dominio verificado en Resend, deja el valor por defecto:
# `onboarding@resend.dev` solo entrega al correo dueño de la cuenta.
# Con dominio verificado: "Media Maratón <plan@tudominio.com>"
# DIGEST_FROM=

# --- Secreto del cron ---
# Vercel lo envía automáticamente en la cabecera Authorization de cada cron.
# Sin esta variable la ruta responde 500 y no envía nada (falla en cerrado).
# CRON_SECRET=

# --- Lista blanca de destinatarios del correo diario (opcional) ---
# Sin dominio verificado en Resend solo se puede entregar al correo del titular
# de la cuenta. Mientras sea el caso, ponlo aquí, separado por comas: así nadie
# activa el interruptor y se queda esperando un correo que nunca llega.
# Si lo dejas vacío, manda la preferencia por usuario de la app.
# DIGEST_RECIPIENTS=bogdanfreshh@gmail.com

# --- URL pública de la app (para el redirect de OAuth y el CSRF) ---
# En local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En Vercel: https://tu-proyecto.vercel.app
