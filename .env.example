# ============================================================
#  Copia este archivo a `.env.local` y rellena los valores.
#  `.env.local` está en .gitignore: NUNCA se sube al repositorio.
# ============================================================

# --- Supabase (público: se expone al navegador, es seguro) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...tu_anon_key

# --- Supabase (SECRETO: solo servidor, NUNCA en el cliente) ---
# Solo se usa para tareas administrativas. No lo necesitas para arrancar.
# SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública de la app (para el redirect de OAuth y el CSRF) ---
# En local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En Vercel: https://tu-proyecto.vercel.app
